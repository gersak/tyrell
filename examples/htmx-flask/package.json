{
  "name": "ty-htmx-flask-example",
  "version": "1.0.0",
  "description": "Flask + HTMX + Tyrell components example (tyrell-components from jsDelivr, Tailwind CSS)",
  "private": true,
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./src/input.css -o ./static/css/app.css --watch",
    "build:css:prod": "npx @tailwindcss/cli -i ./src/input.css -o ./static/css/app.css --minify",
    "build:icons": "esbuild src/icons-source.js --bundle --minify --format=esm --outfile=static/js/icons.js",
    "build:icons:watch": "esbuild src/icons-source.js --bundle --watch --format=esm --outfile=static/js/icons.js",
    "dev": "concurrently \"npm run build:css\" \"npm run build:icons:watch\" \".venv/bin/python app.py\"",
    "build": "npm run build:css:prod && npm run build:icons",
    "setup": "./setup.sh",
    "start": ".venv/bin/python app.py"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "concurrently": "^8.2.2",
    "esbuild": "^0.20.0",
    "tailwindcss": "4.1",
    "tyrell-components": "1.0.0-RC18"
  }
}

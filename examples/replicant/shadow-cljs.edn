{:deps true
 :http {:port 9641}
 :dev-http {8030 "public"}
 :builds
 {:main
  {:target :browser
   :output-dir "public/js"
   :asset-path "/js"
   :modules {:main {:init-fn replicant-example.core/init}}
   :dev {:compiler-options {:optimizations :none
                            :source-map true}}
   :release {:compiler-options {:optimizations :advanced
                                :source-map true
                                :infer-externs :auto}}}}}

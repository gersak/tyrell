  "description": "Replicant example using Tyrell web components (dev.gersak/tyrell + tyrell-components)",
  "main": "public/js/main.js",
  "scripts": {
    "postinstall": "cp node_modules/tyrell-components/css/tyrell.css node_modules/tyrell-components/css/tyrell-theme.css public/css/",

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./lib",
    "rootDir": "./src",

    // JS pass only — declarations are emitted by tsconfig.lib.dts.json, which
    // keeps JSDoc so consumers still get hover docs. Comments are stripped here
    // because nobody reads the shipped .js.
    "declaration": false,
    "declarationMap": false,
    "removeComments": true,

    // No source maps: they resolved to ../../src/*.ts, which `files` never
    // publishes, and sourcesContent was not embedded — dead weight for consumers.
    "sourceMap": false,

    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "jsx": "preserve",

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "lib", "dist", "dev", "src/cdn.ts"]
}

{
  "name": "tyrell-cljs-dev",
  "private": true,
  "version": "0.2.0",
  "description": "Tyrell Components - ClojureScript Implementation & CLJS-only features",
  "main": "dist/tyrell.js",
  "exports": {
    ".": {
      "import": "./dist/tyrell.js"
    },
    "./calendar": {
      "import": "./dist/tyrell-calendar.js"
    },
    "./calendar-month": {
      "import": "./dist/tyrell-calendar-month.js"
    },
    "./date-picker": {
      "import": "./dist/tyrell-date-picker.js"
    },
    "./dropdown": {
      "import": "./dist/tyrell-dropdown.js"
    },
    "./multiselect": {
      "import": "./dist/tyrell-multiselect.js"
    },
    "./lazy": {
      "import": "./dist/tyrell-lazy.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "keywords": [
    "web-components",
    "clojurescript",
    "calendar",
    "router",
    "i18n"
  ],
  "scripts": {
    "dev": "shadow-cljs -A:dev watch site",
    "dev:site": "shadow-cljs -A:dev watch site",
    "build": "shadow-cljs -A:dev release site",
    "build:site": "shadow-cljs -A:dev release site",
    "build:github": "clj -T:build github-pages",
    "clean": "rm -rf public/js .shadow-cljs ../../docs"
  },
  "devDependencies": {
    "shadow-cljs": "^2.28.19"
  },
  "author": "Gersak <dev@gersak.io>",
  "license": "MIT"
}

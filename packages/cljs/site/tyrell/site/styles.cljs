(ns tyrell.site.styles
  "Site-only chrome styles injected into <head> via tyrell.css/ensure-document-styles!.

   Why here, not in tyrell.css (the npm package): tyrell.css ships interaction
   primitive styling — surfaces, text hierarchy, semantic colors. Page chrome like
   inline-code pills in prose belongs to the CONSUMER of tyrell, not the package
   itself. Putting it here keeps tyrell.css consumable by anyone without forcing
   our docs-site choices on them.

   Why not site.css: site.css is generated by Tailwind v4. Appending hand-written
   rules to a generated file is fragile. This namespace owns its own styles,
   gets hot-reloaded by shadow-cljs, and is visible right next to the CLJS code
   that consumes the resulting variables (the (c \"...\") helper, etc.)."
  (:require [tyrell.css :as css]
            [tyrell.site.docs.theming :as theming]))

;; Inline <code> in prose — styles every <code> that's not a hljs code block.
;; Variables live on :root with a .dark override so the page's existing theme
;; toggle (which adds/removes .dark on <html>) drives the swap automatically.

(def ^:private inline-code-css
  "
:root {
  --ty-inline-code-bg:     #e2e2e2;
  --ty-inline-code-color:  #2b2b2b;
  --ty-inline-code-border: #cfcfcf;
}

.dark {
  --ty-inline-code-bg:     #2a2a2a;
  --ty-inline-code-color:  #e6e6e6;
  --ty-inline-code-border: #3a3a3a;
}

code:not(.hljs) {
  background:    var(--ty-inline-code-bg);
  color:         var(--ty-inline-code-color);
  border:        1px solid var(--ty-inline-code-border);
  padding:       0.125rem 0.375rem;
  border-radius: 4px;
  font-size:     0.75em;

  /* Wrap behavior — long code strings (e.g. window.tyIcons.register({...}))
     break at character boundaries when they don't fit, instead of overflowing
     the parent's right edge. */
  overflow-wrap: anywhere;
  word-break:    break-word;

  /* When an inline <code> wraps across two lines, render a full pill on each
     fragment (rounded corners + padding + border on both sides) instead of
     slicing the decoration in half. Without this, wrapped code looks chopped:
     the first line ends with a flat right edge, the second starts with a flat
     left edge. */
  -webkit-box-decoration-break: clone;
  box-decoration-break:         clone;
}
")

;; Chrome is PINNED; only page content follows the theme playground.
;;
;; The playground writes its dials as an inline style on <html> (see
;; theming.cljs/apply-seed!), so every flavor-derived colour on the page —
;; including the logo, sidebar and TOC — used to retint as visitors dragged the
;; sliders. Re-declaring the same dials on the chrome subtree stops that: for an
;; inherited custom property, a declaration on the element itself always beats
;; whatever it would have inherited, no matter how specific the ancestor rule is
;; (inline style on <html> included). So the chrome resolves its own seeds and
;; the experiment stays inside <main>.
;;
;; Values mirror theming.cljs/default-seeds (light) and dark-curve-defaults
;; (dark) — keep the three in sync. Hues are theme-invariant, so only the L and
;; chroma curves need a dark block; everything else falls through from light.
;;
;; primary-hue/chroma/l-factor are the TYRELL IDENTITY color (orange, tuned
;; per-mode), deliberately NOT the content playground's default (252, violet —
;; picked precisely so a visitor dragging sliders can't land on and be confused
;; with the real brand).
;;
;; The identity is specified as a finished OKLCH swatch per mode:
;;     light  oklch(0.69 0.15 42.1)      dark  oklch(0.71 0.13 42.2)
;; The seeds below are solved BACK from those, through the primary formula in
;; tyrell-theme.css:
;;     --ty-color-primary = oklch(l-base * primary-l-factor,
;;                                primary-chroma * c-base-mult, primary-hue)
;; so the odd-looking numbers are exact, not hand-tuned — re-derive them if you
;; change the swatch or the L/C curves below:
;;     primary-chroma   = C / c-base-mult   (0.92)
;;     primary-l-factor = L / l-base        (light 0.54, dark 0.62)
;; NOTE light pins primary-l-factor explicitly: core's :root ships 0.96, which
;; would otherwise land the identity at 0.518 instead of 0.690.
;;
;; success/warning/danger hue + chroma are literal numbers + l-factor, pinned
;; explicitly to mirror tyrell-theme.css's own defaults — otherwise the
;; playground's per-flavor chroma and l-factor sliders (theming.cljs) would leak
;; into chrome as INLINE overrides on <html>, the same way any un-pinned dial
;; does — see the maintenance note above. They are deliberately NOT re-derived
;; from the identity chroma above: semantic flavors are not the brand, so
;; keeping them fixed is what makes a brand change a one-flavor change.
(def ^:private chrome-pin-css
  "
[data-ty-theme].site-chrome {
  --ty-primary-seed: initial;    /* a playground hex seed must not recolor the chrome */
  --ty-primary-hue: 42.1;
  --ty-primary-chroma: 0.163;    /* 0.163 * 0.92   = 0.150 */
  --ty-primary-l-factor: 1.2778; /* 0.54  * 1.2778 = 0.690 */
  --ty-success-hue: 145;
  --ty-warning-hue: 76;
  --ty-danger-hue: 31;
  --ty-success-chroma: 0.13;     /* was 0.162 / 0.293 — neon, and danger */
  --ty-warning-chroma: 0.333;
  --ty-danger-chroma: 0.2;       /* sat far outside sRGB, clipping to pure red */
  --ty-success-l-factor: 1;
  --ty-warning-l-factor: 1.3;
  --ty-danger-l-factor: 1.01;
  --ty-l-strong: 0.38;
  --ty-l-bold: 0.46;
  --ty-l-base: 0.54;
  --ty-l-soft: 0.72;
  --ty-l-faint: 0.88;
  --ty-c-strong-mult: 0.77;
  --ty-c-bold-mult: 1;
  --ty-c-base-mult: 0.92;
  --ty-c-soft-mult: 0.77;
  --ty-c-faint-mult: 0.46;

  /* Content lifts this to 0.16 so its solid fills read cleanly; chrome keeps
     the library identity value so header/sidebar fills are untouched. */
  --ty-solid-l: 0;
}

.dark [data-ty-theme].site-chrome,
[data-theme=\"dark\"] [data-ty-theme].site-chrome,
[data-ty-theme].site-chrome.dark {
  --ty-primary-hue: 42.2;
  --ty-primary-chroma: 0.1413;   /* 0.1413 * 0.92   = 0.130 */
  --ty-primary-l-factor: 1.1452; /* 0.62   * 1.1452 = 0.710 */
  --ty-success-chroma: 0.12;
  --ty-warning-chroma: 0.355;
  --ty-danger-chroma: 0.19;
  --ty-l-strong: 0.72;
  --ty-l-bold: 0.66;
  --ty-l-base: 0.62;
  --ty-l-soft: 0.46;
  --ty-l-faint: 0.30;
  --ty-c-faint-mult: 0.50;
  --ty-solid-l: -0.2;
}
")

;; Component demos that sit INSIDE the chrome (the hero card on component
;; pages) are components, not the Tyrell identity: .site-demo puts them back
;; on the library defaults. Built from the playground's own default maps, so
;; they match content demos after "Reset". Needs data-ty-theme on the same
;; element so the derived colors re-resolve there instead of inheriting the
;; chrome's.
(defn- dial-lines [m]
  (apply str
         (for [[k v] (sort-by key (select-keys m theming/curve-keys))]
           (str "  --ty-" (name k) ": " v ";\n"))))

(def ^:private demo-pin-css
  (str "
[data-ty-theme].site-demo {
  --ty-primary-seed: initial;
" (dial-lines theming/default-seeds) "
  /* Same solid-fill lift as page content (index.html :root). */
  --ty-solid-l: 0.16;
}

.dark [data-ty-theme].site-demo,
[data-theme=\"dark\"] [data-ty-theme].site-demo,
[data-ty-theme].site-demo.dark {
" (dial-lines (merge theming/default-seeds theming/dark-curve-defaults)) "
  --ty-solid-l: -0.2;
}
"))

;; Keyboard focus in the brand color instead of the browser's default blue.
;; Opt-in per element with .site-focus.
(def ^:private focus-css
  "
.site-focus:focus-visible {
  outline: 2px solid var(--ty-color-primary);
  outline-offset: 2px;
}
")

;; The identity color as one page-wide variable, for accents that live in page
;; content but should read as Tyrell (e.g. the live examples' Inspect mode).
;; Same swatches as chrome-pin-css above; keep them in sync.
(def ^:private brand-css
  "
:root { --tyrell-brand: oklch(0.69 0.15 42.1); }
.dark, [data-theme=\"dark\"] { --tyrell-brand: oklch(0.71 0.13 42.2); }
")

;; ty ships hover:ty-* but no group-hover:ty-* variants; the two the site uses.
;; !important matches the library's own color utilities.
(def ^:private group-hover-css
  "
.group:hover .group-hover\\:ty-text { color: var(--ty-text) !important; }
.group:hover .group-hover\\:ty-text-primary { color: var(--ty-color-primary) !important; }
")

(defn install!
  "Inject all site-chrome styles into document.head. Idempotent and hot-reloadable
   — calling repeatedly updates the <style> element's content rather than appending
   duplicates. Call from core/init."
  []
  (css/ensure-document-styles! inline-code-css "tyrell-site-inline-code")
  (css/ensure-document-styles! chrome-pin-css "tyrell-site-chrome-pin")
  (css/ensure-document-styles! demo-pin-css "tyrell-site-demo-pin")
  (css/ensure-document-styles! focus-css "tyrell-site-focus")
  (css/ensure-document-styles! brand-css "tyrell-site-brand")
  (css/ensure-document-styles! group-hover-css "tyrell-site-group-hover"))

{:deps true
 :nrepl {:port 7888}
 :dev-http {8010 {:root "public"
                  :host "0.0.0.0"}}

 :builds
 {;; Documentation site development build
  :site
  {:target :browser
   :output-dir "public/js"
   :asset-path "/js"
   :modules {:site {:init-fn tyrell.site.core/init}}
   :compiler-options {:optimizations :none
                      :source-map true}}

  ;; GitHub Pages deployment build
  :github
  {:target :browser
   :output-dir "../../docs/js"
   :asset-path "js"
   :modules {:site {:init-fn tyrell.site.core/init}}
   :closure-defines {tyrell.site.core/ROUTER_BASE "tyrell"
                     tyrell.site.core/PRODUCTION true}
   :compiler-options {:optimizations :advanced
                      :source-map true
                      :pretty-print false
                      :infer-externs :auto}}}}
